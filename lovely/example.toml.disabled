# Lovely patch example — rename to `example.toml` to activate.
#
# Steamodded covers almost everything you'd want to add. Reach for Lovely only
# when you need to change a line of Balatro's own source that Steamodded gives
# you no hook for. Patched files live in Mods/lovely/dump/ after a run, which
# is the easiest way to confirm a patch actually applied.
#
# Docs: https://github.com/ethangreen-dev/lovely-injector

[manifest]
version = "1.0.0"
dump_lua = true
priority = 0

# Insert code after a matched line.
[[patches]]
[patches.pattern]
target = "game.lua"
pattern = "function Game:start_run(args)"
position = "after"
payload = "sendInfoMessage('run starting', 'CelestasMod')"
match_indent = true

# Swap one string for another everywhere in a file.
[[patches]]
[patches.regex]
target = "functions/common_events.lua"
pattern = "(?<indent>[\t ]*)local edition = poll_edition"
position = "before"
payload = "-- CelestasMod was here"
line_prepend = "$indent"
